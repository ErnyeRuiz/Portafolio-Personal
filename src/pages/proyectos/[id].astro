---
/* Versión mínima para que los enlaces no queden rotos.
   El paso 5 del plan la desarrolla: galería, prosa cuidada, navegación
   entre proyectos y metadatos propios. */
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import ActionLink from "../../components/ActionLink.astro";
import { SITIO } from "../../config";

export const getStaticPaths: GetStaticPaths = async () => {
  const proyectos = await getCollection("proyectos", ({ data }) => !data.draft);
  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
};

const { proyecto } = Astro.props;
const { titulo, resumen, tipo, portada, galeria, stack, rol, repo, demo, apk } =
  proyecto.data;
const { Content } = await render(proyecto);

// Backend vive en su propio archivo (misma arquitectura limpia, decisiones
// distintas por proyecto). Es opcional: si no existe, la sección no se pinta.
const backend = await getEntry("backend", proyecto.id);
const BackendContent = backend ? (await render(backend)).Content : undefined;

// El ancho de cada slide depende del tipo de la captura, no del proyecto:
// las de navegador (anchas) van de a una para que se lean; las de celular
// (angostas) van de a una hasta `md` y de a dos desde ahí: antes de ese
// ancho dos teléfonos quedarían más chicos que el marco de 280px.
// Versión grande de cada captura para el visor (lightbox), sin agrandar el original.
const ampliadas = await Promise.all(
  galeria.map(async (item) => {
    const img = await getImage({
      src: item.src,
      width: Math.min(item.src.width, 1800),
    });
    return { src: img.src, alt: item.alt };
  }),
);

const anchoSlide = (tipoCaptura: "web" | "movil") =>
  tipoCaptura === "web" ? "w-full" : "w-full md:w-[calc(50%-0.75rem)]";
---

<BaseLayout titulo={`${titulo} — ${SITIO.nombre}`} descripcion={resumen}>
  <article class="glow-field py-20">
    <div class="mx-auto max-w-3xl px-6">
      <a
        href="/#proyectos"
        class="text-sm text-ink-muted transition hover:text-accent-soft"
      >
        ← Volver a proyectos
      </a>

      <h1 class="mt-8 text-4xl font-bold min-[380px]:text-5xl sm:text-6xl">{titulo}</h1>
      <p class="mt-5 text-xl text-ink-muted">{resumen}</p>

      <ul class="mt-7 flex flex-wrap gap-2">
        {
          rol && (
            <li class="rounded-pill border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-accent-soft">
              {rol}
            </li>
          )
        }
        {
          stack.map((tec) => (
            <li class="rounded-pill border border-border bg-surface px-3 py-1 text-sm text-ink-muted">
              {tec}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-auto mt-16 max-w-5xl px-6">
      <DeviceFrame tipo={tipo} src={portada} alt={`Captura de ${titulo}`} eager />

      {
        (apk || demo || repo) && (
          <div class="mt-10 flex flex-col items-center gap-4 text-center">
            <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
              {apk && (
                <ActionLink
                  href={apk.url}
                  texto="Descargar APK ↓"
                  primario
                  descarga
                  etiquetaQr="Código QR para descargar el APK desde el celular"
                />
              )}
              {demo && (
                <ActionLink
                  href={demo}
                  texto="Visitar ↗"
                  primario
                  etiquetaQr="Código QR para abrir el sitio desde el celular"
                />
              )}
              {repo && (
                <ActionLink
                  href={repo}
                  texto="Repositorio ↗"
                  etiquetaQr="Código QR del repositorio"
                />
              )}
            </div>
            {apk && (
              <p class="max-w-md text-sm text-ink-muted">
                {[apk.version && `v${apk.version}`, apk.tamano, "Solo Android"]
                  .filter(Boolean)
                  .join(" · ")}
                . Tu teléfono puede pedirte permitir la instalación desde este
                navegador.
              </p>
            )}
          </div>
        )
      }
    </div>

    <div
      class="prose-portafolio mx-auto mt-16 max-w-3xl px-6 text-lg text-ink-muted"
    >
      <Content />
    </div>

    {
      galeria.length > 0 && (
        <div class="mx-auto mt-20 max-w-5xl px-6">
          <h2 class="text-3xl font-bold sm:text-4xl">Galería</h2>

          <div class="relative mt-8 sm:px-12">
            <div
              data-carousel-track
              tabindex="0"
              role="region"
              aria-label="Galería de capturas"
              class="carousel-track flex items-start snap-x transition-[height] duration-300 snap-mandatory gap-6 overflow-x-auto overflow-y-hidden scroll-smooth"
            >
              {galeria.map((item, i) => (
                <figure
                  class:list={[
                    anchoSlide(item.tipo ?? tipo),
                    "flex-none snap-start",
                  ]}
                >
                  <button
                    type="button"
                    data-lightbox-open={i}
                    aria-label={`Ampliar: ${item.alt}`}
                    class="block w-full cursor-zoom-in rounded-card focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  >
                    <DeviceFrame
                      tipo={item.tipo ?? tipo}
                      src={item.src}
                      alt={item.alt}
                    />
                  </button>
                  <figcaption class="mt-3 text-center text-sm text-ink-muted">
                    {item.alt}
                  </figcaption>
                </figure>
              ))}
            </div>

            <button
              type="button"
              aria-label="Captura anterior"
              data-carousel-prev
              class="absolute left-1 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/80 text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink aria-disabled:cursor-default aria-disabled:opacity-30 aria-disabled:hover:border-border aria-disabled:hover:text-ink-muted sm:left-0 sm:size-10 sm:bg-transparent sm:backdrop-blur-none"
            >
              ‹
            </button>

            <button
              type="button"
              aria-label="Siguiente captura"
              data-carousel-next
              class="absolute right-1 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/80 text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink aria-disabled:cursor-default aria-disabled:opacity-30 aria-disabled:hover:border-border aria-disabled:hover:text-ink-muted sm:right-0 sm:size-10 sm:bg-transparent sm:backdrop-blur-none"
            >
              ›
            </button>
          </div>

          <p
            data-carousel-count
            aria-live="polite"
            class="mt-4 text-center text-sm text-ink-muted tabular-nums"
          >
          </p>
        </div>
      )
    }

    {
      galeria.length > 0 && (
        <dialog
          data-lightbox
          data-items={JSON.stringify(ampliadas)}
          aria-label="Visor de capturas"
          class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-ink"
        >
          <div class="flex h-full flex-col items-center justify-center gap-4 px-4 py-6 sm:px-16">
            <button
              type="button"
              data-lightbox-close
              aria-label="Cerrar visor"
              class="absolute right-4 top-4 z-10 flex size-11 items-center justify-center rounded-pill border border-border bg-bg/70 text-xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink"
            >
              ✕
            </button>
            <button
              type="button"
              data-lightbox-prev
              aria-label="Captura anterior"
              class="absolute left-3 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/70 text-2xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink sm:left-5"
            >
              ‹
            </button>
            <button
              type="button"
              data-lightbox-next
              aria-label="Siguiente captura"
              class="absolute right-3 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/70 text-2xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink sm:right-5"
            >
              ›
            </button>
            <img
              data-lightbox-img
              src=""
              alt=""
              class="min-h-0 max-w-full flex-1 rounded-card object-contain shadow-2xl shadow-black/60"
            />
            <p class="text-center text-sm text-ink-muted">
              <span data-lightbox-caption />
              <span data-lightbox-count class="ml-2 tabular-nums" />
            </p>
          </div>
        </dialog>
      )
    }

    {
      backend && BackendContent && (
        <div class="glow-soft mx-auto mt-20 max-w-3xl px-6">
          <div class="card-gradient-border rounded-card p-8 sm:p-10">
            <p class="font-display text-sm tracking-[0.2em] text-accent uppercase">
              Backend
            </p>
            <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
              {backend.data.arquitectura}
            </h2>

            <ul class="mt-6 flex flex-wrap gap-2">
              {backend.data.stack.map((tec) => (
                <li class="rounded-pill border border-border bg-bg px-3 py-1 text-sm text-ink-muted">
                  {tec}
                </li>
              ))}
            </ul>

            {backend.data.repo && (
              <div class="mt-7">
                <a
                  href={backend.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-pill border border-border px-5 py-2.5 text-sm font-medium text-ink-muted transition hover:border-accent hover:text-ink"
                >
                  Repositorio ↗
                </a>
              </div>
            )}

            <div class="prose-portafolio mt-10 text-lg text-ink-muted">
              <BackendContent />
            </div>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: lightbox-in 0.2s ease-out;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }

  .carousel-track {
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-lightbox-open]",
  );

  if (dialog && triggers.length > 0) {
    const ampliadas: { src: string; alt: string }[] = JSON.parse(
      dialog.dataset.items ?? "[]",
    );
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const caption = dialog.querySelector("[data-lightbox-caption]")!;
    const count = dialog.querySelector("[data-lightbox-count]")!;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + ampliadas.length) % ampliadas.length;
      const { src, alt } = ampliadas[actual];
      img.src = src;
      img.alt = alt;
      caption.textContent = alt;
      count.textContent = `${actual + 1} / ${ampliadas.length}`;
    };

    triggers.forEach((trigger) =>
      trigger.addEventListener("click", () => {
        mostrar(Number(trigger.dataset.lightboxOpen));
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      }),
    );

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });
    dialog
      .querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog
      .querySelector("[data-lightbox-prev]")
      ?.addEventListener("click", () => mostrar(actual - 1));
    dialog
      .querySelector("[data-lightbox-next]")
      ?.addEventListener("click", () => mostrar(actual + 1));

    // Click fuera de la imagen y los controles cierra el visor.
    dialog.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el === dialog || el.parentElement === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") mostrar(actual - 1);
      if (e.key === "ArrowRight") mostrar(actual + 1);
    });

    // Swipe horizontal en pantallas táctiles.
    let inicioX = 0;
    dialog.addEventListener(
      "touchstart",
      (e) => (inicioX = e.touches[0].clientX),
      { passive: true },
    );
    dialog.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - inicioX;
        if (Math.abs(dx) > 50) mostrar(actual + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }

  document
    .querySelectorAll<HTMLDivElement>("[data-carousel-track]")
    .forEach((track) => {
      const wrapper = track.parentElement;

      // El alto del track sigue a las capturas visibles, no a la más alta de
      // toda la galería (si no, las capturas bajas dejan huecos arriba/abajo).
      const figures = Array.from(track.querySelectorAll("figure"));
      const fitHeight = () => {
        const box = track.getBoundingClientRect();
        const visibles = figures.filter((figure) => {
          const r = figure.getBoundingClientRect();
          return r.right > box.left + 1 && r.left < box.right - 1;
        });
        const alto = Math.ceil(
          Math.max(0, ...visibles.map((f) => f.getBoundingClientRect().height)),
        );
        if (alto > 0) track.style.height = `${alto}px`;
      };
      const prev = wrapper?.querySelector<HTMLButtonElement>(
        "[data-carousel-prev]",
      );
      const next = wrapper?.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );
      const count = wrapper?.parentElement?.querySelector(
        "[data-carousel-count]",
      );

      // Contador ("3 / 15" o "14–15 / 15" si se ven varias) y flechas
      // deshabilitadas en los extremos. Usa aria-disabled para no perder el foco.
      const updateState = () => {
        const box = track.getBoundingClientRect();
        const indices = figures.flatMap((figure, i) => {
          const r = figure.getBoundingClientRect();
          return r.right > box.left + 1 && r.left < box.right - 1 ? [i + 1] : [];
        });
        if (count && indices.length > 0) {
          const first = indices[0];
          const last = indices[indices.length - 1];
          count.textContent =
            first === last
              ? `${first} / ${figures.length}`
              : `${first}–${last} / ${figures.length}`;
        }
        const alInicio = track.scrollLeft <= 1;
        const alFinal =
          track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
        prev?.setAttribute("aria-disabled", String(alInicio));
        next?.setAttribute("aria-disabled", String(alFinal));
      };

      const update = () => {
        fitHeight();
        updateState();
      };
      const observer = new ResizeObserver(update);
      figures.forEach((figure) => observer.observe(figure));
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();

      prev?.addEventListener("click", () => {
        if (prev.getAttribute("aria-disabled") === "true") return;
        track.scrollBy({ left: -track.clientWidth, behavior: "smooth" });
      });
      next?.addEventListener("click", () => {
        if (next.getAttribute("aria-disabled") === "true") return;
        track.scrollBy({ left: track.clientWidth, behavior: "smooth" });
      });
    });
</script>

<style is:global>
  /* Estilos de prosa para el Markdown. El paso 5 los afina. */
  .prose-portafolio {
    overflow-wrap: break-word;
  }

  .prose-portafolio h2 {
    color: var(--color-ink);
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .prose-portafolio p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose-portafolio a {
    color: var(--color-accent-soft);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }

  .prose-portafolio ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose-portafolio li {
    margin-bottom: 0.5rem;
  }

  .prose-portafolio strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .prose-portafolio code {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
</style>
