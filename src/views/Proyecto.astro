---
import { render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import ActionLink from "../components/ActionLink.astro";
import QrDock from "../components/QrDock.astro";
import TagList from "../components/TagList.astro";
import Gallery from "../components/Gallery.astro";
import Lightbox from "../components/Lightbox.astro";
import { SITIO } from "../config";
import { obtenerBackend, type Proyecto } from "../lib/proyectos";
import { obtenerLang, rutaLocal, useTranslations } from "../i18n/utils";

// Página de un proyecto, compartida por `/proyectos/<id>` y `/en/proyectos/<id>`.
interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const lang = obtenerLang(Astro.currentLocale);
const t = useTranslations(lang);

const { titulo, resumen, tipo, portada, galeria, stack, rol, repo, demo, apk } =
  proyecto.data;
const { Content } = await render(proyecto.entry);

// Backend vive en su propio archivo (misma arquitectura limpia, decisiones
// distintas por proyecto). Es opcional: si no existe, la sección no se pinta.
const backend = await obtenerBackend(proyecto.id, lang);
const BackendContent = backend ? (await render(backend.entry)).Content : undefined;

// El dock de QR ofrece los mismos destinos que los botones, para pasarlos al celular.
interface DestinoQr {
  etiqueta: string;
  href: string;
  descripcion: string;
}

const qrItems = [
  {
    etiqueta: t("qr.apk"),
    href: apk?.url,
    descripcion: t("qr.apkDescripcion"),
  },
  {
    etiqueta: t("qr.sitio"),
    href: demo,
    descripcion: t("qr.sitioDescripcion"),
  },
  {
    etiqueta: t("qr.repo"),
    href: repo,
    descripcion: t("qr.repoDescripcion"),
  },
].filter((item): item is DestinoQr => Boolean(item.href));
---

{/* La portada de un proyecto móvil es vertical y las redes la recortan mal:
    esos proyectos usan la imagen genérica del sitio. */}
<BaseLayout
  titulo={`${titulo} — ${SITIO.nombre}`}
  descripcion={resumen}
  imagen={tipo === "web" ? portada : undefined}
>
  <article class="glow-field py-20">
    <div class="mx-auto max-w-3xl px-6">
      <a
        href={`${rutaLocal(lang)}#proyectos`}
        class="text-sm text-ink-muted transition hover:text-accent-soft"
      >
        {t("proyecto.volver")}
      </a>

      <h1 class="mt-8 text-4xl font-bold min-[380px]:text-5xl sm:text-6xl">
        {titulo}
      </h1>
      <p class="mt-5 text-xl text-ink-muted">{resumen}</p>

      <TagList rol={rol} stack={stack} class="mt-7" />
    </div>

    <div class="mx-auto mt-16 max-w-5xl px-6">
      <DeviceFrame
        tipo={tipo}
        src={portada}
        alt={t("proyectos.capturaDe", { titulo })}
        eager
      />

      {(apk || demo || repo) && (
        <div class="mt-10 flex flex-col items-center gap-4 text-center">
          <div class="flex flex-wrap items-center justify-center gap-4">
            {apk && (
              <ActionLink
                href={apk.url}
                texto={t("accion.descargarApk")}
                variante="primario"
                descarga
              />
            )}
            {demo && (
              <ActionLink
                href={demo}
                texto={t("accion.visitar")}
                variante="primario"
                externo
              />
            )}
            {repo && (
              <ActionLink href={repo} texto={t("accion.repositorio")} externo />
            )}
          </div>
          {apk && (
            <p class="max-w-md text-sm text-ink-muted">
              {[
                apk.version && `v${apk.version}`,
                apk.tamano,
                t("proyecto.soloAndroid"),
              ]
                .filter(Boolean)
                .join(" · ")}
              . {t("proyecto.avisoApk")}
            </p>
          )}
        </div>
      )}
    </div>

    {qrItems.length > 0 && <QrDock items={qrItems} />}

    <div class="prose-portafolio mx-auto mt-16 max-w-3xl px-6 text-lg text-ink-muted">
      <Content />
    </div>

    {galeria.length > 0 && (
      <>
        <Gallery galeria={galeria} tipo={tipo} />
        <Lightbox galeria={galeria} />
      </>
    )}

    {backend && BackendContent && (
      <div class="glow-soft mx-auto mt-20 max-w-3xl px-6">
        <div class="card-gradient-border rounded-card p-8 sm:p-10">
          <p class="font-display text-sm tracking-[0.2em] text-accent uppercase">
            {t("proyecto.backend")}
          </p>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
            {backend.data.arquitectura}
          </h2>

          <TagList stack={backend.data.stack} fondo="bg" class="mt-6" />

          {backend.data.repo && (
            <div class="mt-7">
              <ActionLink
                href={backend.data.repo}
                texto={t("accion.repositorio")}
                externo
              />
            </div>
          )}

          <div class="prose-portafolio mt-10 text-lg text-ink-muted">
            <BackendContent />
          </div>
        </div>
      </div>
    )}
  </article>
</BaseLayout>
