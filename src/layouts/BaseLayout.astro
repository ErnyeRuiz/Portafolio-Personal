---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import ogPorDefecto from "../assets/og-default.png";
import {
  IDIOMA_BASE,
  IDIOMAS,
  LOCALE_OG,
  obtenerLang,
  otroIdioma,
  rutaLocal,
  rutaSinIdioma,
  useTranslations,
} from "../i18n/utils";

interface Props {
  titulo: string;
  descripcion?: string;
  /** Imagen para la vista previa en redes; si falta, se usa la genérica. */
  imagen?: ImageMetadata;
  /** Páginas sin equivalente por idioma (404): no declaran `hreflang`. */
  sinAlternas?: boolean;
}

const lang = obtenerLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  titulo,
  descripcion = t("sitio.descripcion"),
  imagen = ogPorDefecto,
  sinAlternas = false,
} = Astro.props;

// Ruta de la página sin el prefijo de idioma: sirve para armar su equivalente
// en cada locale (hreflang y selector de idioma).
const ruta = sinAlternas ? "" : rutaSinIdioma(Astro.url.pathname);
const urlDe = (idioma: (typeof IDIOMAS)[number]) =>
  new URL(rutaLocal(idioma, ruta), Astro.site);
const canonica = sinAlternas
  ? new URL(Astro.url.pathname, Astro.site)
  : urlDe(lang);
const otra = otroIdioma(lang);

// Las vistas previas piden 1200 px de ancho y no aceptan formatos modernos.
const og = await getImage({ src: imagen, width: 1200, format: "png" });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonica} />
    {!sinAlternas &&
      IDIOMAS.map((idioma) => (
        <link rel="alternate" hreflang={idioma} href={urlDe(idioma)} />
      ))}
    {!sinAlternas && (
      <link rel="alternate" hreflang="x-default" href={urlDe(IDIOMA_BASE)} />
    )}

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={LOCALE_OG[lang]} />
    <meta property="og:locale:alternate" content={LOCALE_OG[otra]} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={og.attributes.width} />
    <meta property="og:image:height" content={og.attributes.height} />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#0a0f1e" />
  </head>

  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-accent focus:px-5 focus:py-3 focus:text-bg"
    >
      {t("layout.saltar")}
    </a>

    {/* La portada va antes del header: así la barra queda debajo de ella y
        solo se pega arriba (sticky) al avanzar el scroll. */}
    <slot name="portada" />

    <Header hrefOtroIdioma={rutaLocal(otra, ruta)} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>
