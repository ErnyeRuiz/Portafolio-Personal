---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import { SITIO } from "../config";
import ogPorDefecto from "../assets/og-default.png";

interface Props {
  titulo: string;
  descripcion?: string;
  /** Imagen para la vista previa en redes; si falta, se usa la genérica. */
  imagen?: ImageMetadata;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  imagen = ogPorDefecto,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);

// Las vistas previas piden 1200 px de ancho y no aceptan formatos modernos.
const og = await getImage({ src: imagen, width: 1200, format: "png" });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonica} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={og.attributes.width} />
    <meta property="og:image:height" content={og.attributes.height} />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#0a0f1e" />
  </head>

  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-accent focus:px-5 focus:py-3 focus:text-bg"
    >
      Saltar al contenido
    </a>

    {/* La portada va antes del header: así la barra queda debajo de ella y
        solo se pega arriba (sticky) al avanzar el scroll. */}
    <slot name="portada" />

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>
