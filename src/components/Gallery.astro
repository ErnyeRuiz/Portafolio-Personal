---
import type { CollectionEntry } from "astro:content";
import DeviceFrame from "./DeviceFrame.astro";

interface Props {
  galeria: CollectionEntry<"proyectos">["data"]["galeria"];
  /** Tipo por defecto de las capturas; cada una puede traer el suyo. */
  tipo: "web" | "movil";
}

const { galeria, tipo } = Astro.props;

// El ancho de cada slide depende del tipo de la captura, no del proyecto:
// las de navegador (anchas) van de a una para que se lean; las de celular
// (angostas) van de a una hasta `md` y de a dos desde ahí: antes de ese
// ancho dos teléfonos quedarían más chicos que el marco de 280px.
const anchoSlide = (tipoCaptura: "web" | "movil") =>
  tipoCaptura === "web" ? "w-full" : "w-full md:w-[calc(50%-0.75rem)]";

const claseFlecha =
  "absolute -bottom-14 z-10 flex size-10 items-center justify-center rounded-pill border border-border bg-bg/80 text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink aria-disabled:cursor-default aria-disabled:opacity-30 aria-disabled:hover:border-border aria-disabled:hover:text-ink-muted";
---

<div data-carousel class="mx-auto mt-20 max-w-5xl px-6">
  <h2 class="text-3xl font-bold sm:text-4xl">Galería</h2>

  <div class="relative mt-8">
    <div
      data-carousel-track
      tabindex="0"
      role="region"
      aria-label="Galería de capturas"
      class="carousel-track flex items-start snap-x transition-[height] duration-300 snap-mandatory gap-6 overflow-x-auto overflow-y-hidden scroll-smooth"
    >
      {
        galeria.map((item, i) => (
          <figure
            class:list={[anchoSlide(item.tipo ?? tipo), "flex-none snap-start"]}
          >
            <button
              type="button"
              data-lightbox-open={i}
              aria-label={`Ampliar: ${item.alt}`}
              class="block w-full cursor-zoom-in rounded-card focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              <DeviceFrame
                tipo={item.tipo ?? tipo}
                src={item.src}
                alt={item.alt}
              />
            </button>
            <figcaption class="mt-3 text-center text-sm text-ink-muted">
              {item.alt}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <button
      type="button"
      aria-label="Captura anterior"
      data-carousel-prev
      class:list={[claseFlecha, "left-[calc(50%-5.5rem)]"]}
    >
      ‹
    </button>

    <button
      type="button"
      aria-label="Siguiente captura"
      data-carousel-next
      class:list={[claseFlecha, "right-[calc(50%-5.5rem)]"]}
    >
      ›
    </button>
  </div>

  <p
    data-carousel-count
    aria-live="polite"
    class="mt-4 flex h-10 items-center justify-center text-center text-sm text-ink-muted tabular-nums"
  >
  </p>
</div>

<style>
  .carousel-track {
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { iniciarCarrusel } from "../scripts/carousel";

  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach(iniciarCarrusel);
</script>
