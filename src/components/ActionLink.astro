---
interface Props {
  href: string;
  texto: string;
  variante?: "primario" | "secundario";
  /** Abre en otra pestaña (sitios externos). */
  externo?: boolean;
  descarga?: boolean;
  class?: string;
}

const {
  href,
  texto,
  variante = "secundario",
  externo = false,
  descarga = false,
  class: clase,
} = Astro.props;
---

<a
  href={href}
  download={descarga || undefined}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener noreferrer" : undefined}
  class:list={[
    "rounded-pill px-7 py-3.5 font-medium transition",
    variante === "primario"
      ? "bg-accent text-bg hover:bg-accent-soft"
      : "border border-border text-ink-muted hover:border-accent hover:text-ink",
    clase,
  ]}
>
  {texto}
</a>
