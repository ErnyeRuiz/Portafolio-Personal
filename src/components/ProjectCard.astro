---
import type { CollectionEntry } from "astro:content";
import DeviceFrame from "./DeviceFrame.astro";

interface Props {
  proyecto: CollectionEntry<"proyectos">;
}

const { proyecto } = Astro.props;
const { titulo, resumen, tipo, portada, stack, rol } = proyecto.data;
const href = `/proyectos/${proyecto.id}`;
---

<article class="rise flex flex-col gap-6">
  <a href={href} class="group block" aria-label={`Ver el caso de ${titulo}`}>
    <DeviceFrame tipo={tipo} src={portada} alt={`Captura de ${titulo}`} />
  </a>

  <div class="flex flex-1 flex-col">
    <h3 class="text-3xl font-bold">
      <a href={href} class="hover:text-accent-soft">{titulo}</a>
    </h3>

    <p class="mt-3 text-ink-muted">{resumen}</p>

    <ul class="mt-5 flex flex-wrap gap-2">
      {
        rol && (
          <li class="rounded-pill border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-accent-soft">
            {rol}
          </li>
        )
      }
      {
        stack.map((tec) => (
          <li class="rounded-pill border border-border bg-surface px-3 py-1 text-sm text-ink-muted">
            {tec}
          </li>
        ))
      }
    </ul>

    <div class="mt-auto pt-6">
      <a
        href={href}
        class="inline-block rounded-pill bg-accent px-6 py-3 font-medium text-bg transition hover:bg-accent-soft"
      >
        Ver caso →
      </a>
    </div>
  </div>
</article>
