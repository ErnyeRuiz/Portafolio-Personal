---
import DeviceFrame from "./DeviceFrame.astro";
import ActionLink from "./ActionLink.astro";
import TagList from "./TagList.astro";
import type { Proyecto } from "../lib/proyectos";
import { obtenerLang, rutaLocal, useTranslations } from "../i18n/utils";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const { titulo, resumen, tipo, portada, stack, rol } = proyecto.data;
const lang = obtenerLang(Astro.currentLocale);
const t = useTranslations(lang);
const href = rutaLocal(lang, `proyectos/${proyecto.id}`);
---

<article class="rise flex flex-col gap-6">
  <a
    href={href}
    class="group block"
    aria-label={t("proyectos.verCasoDe", { titulo })}
  >
    <DeviceFrame
      tipo={tipo}
      src={portada}
      alt={t("proyectos.capturaDe", { titulo })}
    />
  </a>

  <div class="flex flex-1 flex-col">
    <h3 class="text-3xl font-bold">
      <a href={href} class="hover:text-accent-soft">
        {titulo}
      </a>
    </h3>

    <p class="mt-3 text-ink-muted">{resumen}</p>

    <TagList rol={rol} stack={stack} class="mt-5" />

    <div class="mt-auto pt-6">
      <ActionLink
        href={href}
        texto={t("proyectos.verCaso")}
        variante="primario"
        class="inline-block"
      />
    </div>
  </div>
</article>
