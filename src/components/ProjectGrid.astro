---
import type { CollectionEntry } from "astro:content";
import ProjectRow from "./ProjectRow.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  proyectos: CollectionEntry<"proyectos">[];
}

const { proyectos } = Astro.props;

/* Este componente decide el layout según cuántos proyectos haya.
   Con pocos, filas anchas alternadas: cada proyecto ocupa la pantalla
   y el conjunto no se ve escaso. Al pasar de ~4, las filas se vuelven
   larguísimas y conviene cambiar a cuadrícula dejando las filas anchas
   solo para los `destacado: true`. Ese cambio se hace aquí y nada más. */
const UMBRAL_CUADRICULA = 4;
const usarFilas = proyectos.length < UMBRAL_CUADRICULA;
const destacados = proyectos.filter(({ data }) => data.destacado);
const resto = proyectos.filter(({ data }) => !data.destacado);
---

<section class="glow-field glow-soft py-24 sm:py-32">
  <div id="proyectos" class="mx-auto max-w-6xl px-6">
    <header class="rise mb-16 max-w-2xl">
      <h2 class="text-3xl font-bold sm:text-4xl">Proyectos</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Lo que he desarrollado y mis conocimientos técnicos.
      </p>
    </header>

    {usarFilas ? (
      <div class="space-y-28 sm:space-y-36">
        {proyectos.map((proyecto, i) => (
          <ProjectRow proyecto={proyecto} indice={i} />
        ))}
      </div>
    ) : (
      <div class="space-y-28 sm:space-y-36">
        {destacados.length > 0 && (
          <div class="space-y-28 sm:space-y-36">
            {destacados.map((proyecto, i) => (
              <ProjectRow proyecto={proyecto} indice={i} />
            ))}
          </div>
        )}
        {resto.length > 0 && (
          <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2">
            {resto.map((proyecto) => (
              <ProjectCard proyecto={proyecto} />
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</section>
