---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { obtenerLang, useTranslations } from "../i18n/utils";

interface Props {
  galeria: CollectionEntry<"proyectos">["data"]["galeria"];
}

const { galeria } = Astro.props;
const t = useTranslations(obtenerLang(Astro.currentLocale));

// Versión grande de cada captura para el visor, sin agrandar el original.
const ampliadas = await Promise.all(
  galeria.map(async (item) => {
    const img = await getImage({
      src: item.src,
      width: Math.min(item.src.width, 1800),
    });
    return { src: img.src, alt: item.alt };
  }),
);
---

<dialog
  data-lightbox
  data-items={JSON.stringify(ampliadas)}
  aria-label={t("visor.etiqueta")}
  class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-ink"
>
  <div class="flex h-full flex-col items-center justify-center gap-4 px-4 py-6 sm:px-16">
    <button
      type="button"
      data-lightbox-close
      aria-label={t("visor.cerrar")}
      class="absolute right-4 top-4 z-10 flex size-11 items-center justify-center rounded-pill border border-border bg-bg/70 text-xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink"
    >
      ✕
    </button>
    <button
      type="button"
      data-lightbox-prev
      aria-label={t("galeria.anterior")}
      class="absolute left-3 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/70 text-2xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink sm:left-5"
    >
      ‹
    </button>
    <button
      type="button"
      data-lightbox-next
      aria-label={t("galeria.siguiente")}
      class="absolute right-3 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-pill border border-border bg-bg/70 text-2xl text-ink-muted backdrop-blur transition hover:border-accent hover:text-ink sm:right-5"
    >
      ›
    </button>
    <img
      data-lightbox-img
      src=""
      alt=""
      class="min-h-0 max-w-full flex-1 touch-pinch-zoom rounded-card object-contain shadow-2xl shadow-black/60"
    />
    <p class="text-center text-sm text-ink-muted">
      <span data-lightbox-caption></span>
      <span data-lightbox-count class="ml-2 tabular-nums"></span>
    </p>
  </div>
</dialog>

<style>
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: lightbox-in 0.2s ease-out;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }
</style>

<script>
  import { iniciarVisor } from "../scripts/lightbox";

  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const disparadores = document.querySelectorAll<HTMLButtonElement>(
    "[data-lightbox-open]",
  );

  if (dialog && disparadores.length > 0) iniciarVisor(dialog, disparadores);
</script>
