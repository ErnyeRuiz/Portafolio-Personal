---
import ActionLink from "./ActionLink.astro";
---

<section class="glow-field flex min-h-dvh items-center py-24">
  <div class="mx-auto max-w-6xl px-6">

    <h1 class="mt-6 max-w-4xl text-4xl font-bold min-[380px]:text-5xl sm:text-6xl lg:text-7xl">
      ¡Hola! <span class="text-gradient">Soy Ernye</span>
    </h1>

    <p class="mt-6 max-w-4xl text-4xl font-bold min-[380px]:text-5xl sm:text-6xl">
      Soy desarrollador <span class="text-gradient">Full Stack</span>
    </p>

    <div class="mt-12 flex flex-wrap gap-4">
      <ActionLink href="#sobre-mi" texto="Sobre mí" variante="primario" />
      <ActionLink href="#proyectos" texto="Proyectos" />
    </div>
  </div>
</section>
