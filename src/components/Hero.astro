---
import ActionLink from "./ActionLink.astro";
import { obtenerLang, useTranslations } from "../i18n/utils";

const t = useTranslations(obtenerLang(Astro.currentLocale));
const rolDespues = t("hero.rolDespues");
---

<section class="glow-field flex min-h-dvh items-center py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h1 class="mt-6 max-w-4xl text-4xl font-bold min-[380px]:text-5xl sm:text-6xl lg:text-7xl">
      {t("hero.saludo")} <span class="text-gradient">{t("hero.nombre")}</span>
    </h1>

    <p class="mt-6 max-w-4xl text-4xl font-bold min-[380px]:text-5xl sm:text-6xl">
      {t("hero.rolAntes")} <span class="text-gradient">Full Stack</span>
      {rolDespues && ` ${rolDespues}`}
    </p>

    <div class="mt-12 flex flex-wrap gap-4">
      <ActionLink
        href="#sobre-mi"
        texto={t("nav.sobreMi")}
        variante="primario"
      />
      <ActionLink href="#proyectos" texto={t("nav.proyectos")} />
    </div>
  </div>
</section>
