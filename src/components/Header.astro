---
import { SITIO } from "../config";

const enlaces = [
  { href: "/#sobre-mi", texto: "Sobre mí" },
  { href: "/#proyectos", texto: "Proyectos" },
  { href: "/#contacto", texto: "Contacto" },
];
---

{/* El blur va en un ::before y no en el <header>: un backdrop-filter en el
    ancestro hace que el blur del menú desplegable solo "vea" el header y no la
    página, y el menú se ve transparente. */}
<header
  class="sticky top-0 z-50 border-b border-border/60 before:absolute before:inset-0 before:-z-10 before:bg-bg/70 before:backdrop-blur-lg before:content-['']"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6"
    aria-label="Principal"
  >
    <a
      href="/"
      data-marca
      class="font-display text-base font-bold tracking-tight whitespace-nowrap hover:text-accent-soft sm:text-lg"
    >
      {SITIO.nombre}
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menú"
      class="group ml-auto flex size-11 items-center justify-center rounded-pill text-ink-muted transition hover:bg-surface hover:text-ink sm:hidden"
    >
      <svg
        class="size-6 group-aria-expanded:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        class="hidden size-6 group-aria-expanded:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <ul
      id="menu-principal"
      data-menu
      class="absolute inset-x-0 top-full hidden flex-col border-b border-border/60 bg-bg/95 px-4 py-2 backdrop-blur-lg data-[open]:flex sm:static sm:ml-auto sm:flex sm:flex-row sm:items-center sm:gap-2 sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
    >
      {
        enlaces.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              class="block rounded-pill px-4 py-3 text-base text-ink-muted transition hover:bg-surface hover:text-ink sm:py-2 sm:text-sm"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-menu-toggle]",
  );
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  const setOpen = (abierto: boolean) => {
    if (!toggle || !menu) return;
    menu.toggleAttribute("data-open", abierto);
    toggle.setAttribute("aria-expanded", String(abierto));
    toggle.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
  };

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  // En la portada la marca no recarga: sube al inicio de la página.
  document.querySelector("[data-marca]")?.addEventListener("click", (e) => {
    if (window.location.pathname !== "/") return;
    e.preventDefault();
    setOpen(false);
    window.scrollTo({ top: 0 });
  });
  // Un enlace lleva a un ancla: el menú se cierra para no tapar la sección.
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    // Solo actúa con el menú abierto: si no, robaría el foco a un input o diálogo.
    if (e.key === "Escape" && menu?.hasAttribute("data-open")) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Al pasar a escritorio el menú vuelve a ser la barra horizontal.
  window
    .matchMedia("(min-width: 40rem)")
    .addEventListener("change", (e) => e.matches && setOpen(false));
</script>
