---
import { SITIO } from "../config";

const enlaces = [
  { href: "/#proyectos", texto: "Proyectos" },
  { href: "/#sobre-mi", texto: "Sobre mí" },
  { href: "/#contacto", texto: "Contacto" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/70 backdrop-blur-lg"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Principal"
  >
    <a
      href="/"
      class="font-display text-lg font-bold tracking-tight hover:text-accent-soft"
    >
      {SITIO.nombre}
    </a>

    <ul class="flex items-center gap-1 sm:gap-2">
      {
        enlaces.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              class="rounded-pill px-3 py-2 text-sm text-ink-muted transition hover:bg-surface hover:text-ink sm:px-4"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
