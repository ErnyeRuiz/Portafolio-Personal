---
import { SITIO } from "../config";
import ActionLink from "./ActionLink.astro";
import { obtenerLang, useTranslations } from "../i18n/utils";

const t = useTranslations(obtenerLang(Astro.currentLocale));

// Textos de error para el script del navegador, por código de la API.
const errores = {
  solicitud_invalida: t("error.solicitud_invalida"),
  campos_incompletos: t("error.campos_incompletos"),
  mensaje_largo: t("error.mensaje_largo"),
  email_invalido: t("error.email_invalido"),
  origen_no_permitido: t("error.origen_no_permitido"),
  envio_fallido: t("error.envio_fallido"),
  conexion: t("error.conexion"),
};

const enlaces = [
  { href: SITIO.github, texto: "GitHub ↗" },
  { href: SITIO.linkedin, texto: "LinkedIn ↗" },
];

const claseCampo =
  "input-campo rounded-card border border-border bg-surface px-4 py-3 text-ink focus:border-accent focus:outline-none";
---

<section class="py-24 sm:py-32">
  <div id="contacto" class="mx-auto max-w-6xl px-6">
    <header class="rise max-w-2xl">
      <h2 class="text-3xl font-bold sm:text-4xl">{t("contacto.titulo")}</h2>
      <p class="mt-4 text-lg text-ink-muted">{t("contacto.intro")}</p>
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div
        id="contacto-caja"
        data-fase="reposo"
        data-texto-enviar={t("contacto.enviar")}
        data-texto-enviando={t("contacto.enviando")}
        data-errores={JSON.stringify(errores)}
        class="rise w-full max-w-xl"
      >
        <div class="form-colapsable">
          <div class="form-colapsable-interior">
            <form id="form-contacto" class="grid gap-5" novalidate>
              <label class="campo-salida grid gap-2" style="--i: 0">
                <span class="text-ink-muted">{t("contacto.nombre")}</span>
                <input
                  type="text"
                  name="nombre"
                  required
                  maxlength="100"
                  autocomplete="name"
                  class={claseCampo}
                />
              </label>

              <label class="campo-salida grid gap-2" style="--i: 1">
                <span class="text-ink-muted">{t("contacto.correo")}</span>
                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  class={claseCampo}
                />
              </label>

              <label class="campo-salida grid gap-2" style="--i: 2">
                <span class="text-ink-muted">{t("contacto.mensaje")}</span>
                <textarea
                  name="mensaje"
                  required
                  rows="5"
                  maxlength="2000"
                  class={claseCampo}
                ></textarea>
              </label>

              <!-- Honeypot: oculto para personas, los bots lo llenan. -->
              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label>
                  {t("contacto.honeypot")}
                  <input
                    type="text"
                    name="hp_campo"
                    tabindex="-1"
                    autocomplete="off"
                  />
                </label>
              </div>

              {/* Encima de la fila del botón: abajo quedaba fuera de pantalla en celular. */}
              <p
                id="form-error"
                role="alert"
                tabindex="-1"
                class="franja-error rounded-card px-4 py-3 text-sm"
              ></p>

              <div
                class="campo-salida flex flex-wrap items-center gap-4"
                style="--i: 3"
              >
                <button
                  type="submit"
                  class="boton-enviar w-full rounded-pill bg-accent sm:w-auto px-7 py-3.5 font-medium text-bg transition hover:bg-accent-soft disabled:cursor-wait"
                >
                  <span class="boton-spinner" aria-hidden="true"></span>
                  <span class="boton-texto">{t("contacto.enviar")}</span>
                </button>
                <div class="flex w-full gap-4 sm:ml-auto sm:w-auto">
                  {enlaces.map((enlace) => (
                    <ActionLink
                      {...enlace}
                      externo
                      class="flex-1 text-center sm:flex-none"
                    />
                  ))}
                </div>
              </div>
            </form>
          </div>
        </div>

        <div
          id="form-exito"
          role="status"
          tabindex="-1"
          class="panel-exito card-gradient-border rounded-card p-8 text-center sm:p-10"
        >
          <svg
            class="check-exito mx-auto"
            viewBox="0 0 64 64"
            width="72"
            height="72"
            aria-hidden="true"
          >
            <circle
              class="check-pulso"
              cx="32"
              cy="32"
              r="26"
              fill="none"
            ></circle>
            <circle
              class="check-anillo"
              cx="32"
              cy="32"
              r="26"
              fill="none"
              pathLength="1"
            ></circle>
            <path
              class="check-trazo"
              d="M21 33.5 29 41.5 44 25"
              fill="none"
              pathLength="1"
            ></path>
          </svg>
          <h3 class="panel-exito-titulo mt-6 text-2xl font-bold">
            {t("contacto.exitoTitulo")}
          </h3>
          <p class="panel-exito-texto mt-2 text-ink-muted">
            {t("contacto.exitoTexto")}
          </p>
          <button
            type="button"
            id="form-otro"
            class="panel-exito-texto mt-6 rounded-pill border border-border px-6 py-3 font-medium text-ink-muted transition hover:border-accent hover:text-ink"
          >
            {t("contacto.otro")}
          </button>
          <div class="panel-exito-texto mt-8 flex flex-wrap justify-start gap-4 border-t border-border pt-6">
            {enlaces.map((enlace) => (
              <ActionLink {...enlace} externo class="flex-1 text-center" />
            ))}
          </div>
        </div>
      </div>

      <aside class="rise hidden lg:block">
        <p class="font-display text-sm tracking-[0.2em] text-accent uppercase">
          {t("contacto.correoDirecto")}
        </p>
        <a
          href={`mailto:${SITIO.email}`}
          class="mt-3 block font-display text-2xl font-bold break-all hover:text-accent-soft"
        >
          {SITIO.email}
        </a>
        <p class="mt-4 max-w-sm text-ink-muted">{t("contacto.disponible")}</p>
      </aside>
    </div>
  </div>
</section>

<script>
  const caja = document.querySelector<HTMLElement>("#contacto-caja");
  const form = document.querySelector<HTMLFormElement>("#form-contacto");
  const colapsable = document.querySelector<HTMLElement>(".form-colapsable");
  const error = document.querySelector<HTMLElement>("#form-error");
  const panel = document.querySelector<HTMLElement>("#form-exito");
  const otro = document.querySelector<HTMLButtonElement>("#form-otro");
  const textoBoton = document.querySelector<HTMLElement>(".boton-texto");
  // Los textos llegan traducidos desde el servidor, en atributos data-*.
  const textoEnviar = caja?.dataset.textoEnviar ?? "";
  const textoEnviando = caja?.dataset.textoEnviando ?? "";
  const errores: Record<string, string> = JSON.parse(
    caja?.dataset.errores ?? "{}",
  );

  const campos = () =>
    form
      ? Array.from(
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
            "input, textarea",
          ),
        )
      : [];

  function mostrarError(mensaje: string) {
    if (!error) return;
    error.textContent = mensaje;
    // Reinicia la animación para que el shake se repita en cada fallo.
    error.classList.remove("shake");
    void error.offsetWidth;
    error.classList.add("shake");
    error.focus({ preventScroll: true });
    const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
    error.scrollIntoView({
      block: "center",
      behavior: sinMovimiento.matches ? "auto" : "smooth",
    });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!caja || !error) return;
    if (!form.reportValidity()) return;

    error.textContent = "";
    const body = JSON.stringify(Object.fromEntries(new FormData(form)));

    caja.dataset.fase = "enviando";
    if (textoBoton) textoBoton.textContent = textoEnviando;
    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (boton) boton.disabled = true;
    campos().forEach((c) => (c.readOnly = true));

    let exito = false;
    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body,
      });
      const datos = await res.json().catch(() => ({}));

      if (res.ok && datos.ok) {
        exito = true;
      } else {
        mostrarError(errores[datos.error] ?? errores.envio_fallido);
      }
    } catch {
      mostrarError(errores.conexion);
    }

    if (textoBoton) textoBoton.textContent = textoEnviar;
    if (boton) boton.disabled = false;
    campos().forEach((c) => (c.readOnly = false));

    if (exito) {
      form.reset();
      caja.dataset.fase = "exito";
      colapsable?.setAttribute("inert", "");
      panel?.focus({ preventScroll: true });
    } else {
      caja.dataset.fase = "reposo";
    }
  });

  otro?.addEventListener("click", () => {
    if (!caja) return;
    caja.dataset.fase = "reposo";
    colapsable?.removeAttribute("inert");
    form?.querySelector<HTMLInputElement>("input[name=nombre]")?.focus();
  });
</script>
