---
import { SITIO } from "../config";

const enlaces = [
  { href: `mailto:${SITIO.email}`, texto: "Correo", primario: true },
  { href: SITIO.github, texto: "GitHub ↗", primario: false },
  { href: SITIO.linkedin, texto: "LinkedIn ↗", primario: false },
];
---

<section id="contacto" class="scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <header class="rise max-w-2xl">
      <h2 class="text-3xl font-bold sm:text-4xl">Contacto</h2>
      <p class="mt-4 text-lg text-ink-muted">
        ¿Tienes un proyecto en mente o quieres conversar? Escríbeme.
      </p>
    </header>

    <form id="form-contacto" class="rise mt-10 grid max-w-xl gap-5" novalidate>
      <label class="grid gap-2">
        <span class="text-ink-muted">Nombre</span>
        <input
          type="text"
          name="nombre"
          required
          maxlength="100"
          autocomplete="name"
          class="rounded-card border border-border bg-surface px-4 py-3 text-ink focus:border-accent focus:outline-none"
        />
      </label>

      <label class="grid gap-2">
        <span class="text-ink-muted">Correo</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          class="rounded-card border border-border bg-surface px-4 py-3 text-ink focus:border-accent focus:outline-none"
        />
      </label>

      <label class="grid gap-2">
        <span class="text-ink-muted">Mensaje</span>
        <textarea
          name="mensaje"
          required
          rows="5"
          maxlength="2000"
          class="rounded-card border border-border bg-surface px-4 py-3 text-ink focus:border-accent focus:outline-none"
        ></textarea>
      </label>

      <!-- Honeypot: oculto para personas, los bots lo llenan. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>
          Sitio web
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="rounded-pill bg-accent px-7 py-3.5 font-medium text-bg transition hover:bg-accent-soft disabled:opacity-60"
        >
          Enviar mensaje
        </button>
        <p id="form-estado" role="status" aria-live="polite" class="text-ink-muted"></p>
      </div>
    </form>

    <div class="mt-10 flex flex-wrap gap-4">
      {
        enlaces.map(({ href, texto, primario }) => (
          <a
            href={href}
            target={primario ? undefined : "_blank"}
            rel={primario ? undefined : "noopener noreferrer"}
            class:list={[
              "rounded-pill px-7 py-3.5 font-medium transition",
              primario
                ? "bg-accent text-bg hover:bg-accent-soft"
                : "border border-border text-ink-muted hover:border-accent hover:text-ink",
            ]}
          >
            {texto}
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#form-contacto");
  const estado = document.querySelector<HTMLElement>("#form-estado");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!estado) return;

    if (!form.reportValidity()) return;

    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (boton) boton.disabled = true;
    estado.textContent = "Enviando...";

    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const datos = await res.json().catch(() => ({}));

      if (res.ok && datos.ok) {
        form.reset();
        estado.textContent = "¡Mensaje enviado! Te responderé pronto.";
      } else {
        estado.textContent = datos.error ?? "No se pudo enviar el mensaje.";
      }
    } catch {
      estado.textContent = "Error de conexión. Intenta de nuevo.";
    } finally {
      if (boton) boton.disabled = false;
    }
  });
</script>
