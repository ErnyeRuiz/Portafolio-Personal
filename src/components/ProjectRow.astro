---
import DeviceFrame from "./DeviceFrame.astro";
import ActionLink from "./ActionLink.astro";
import TagList from "./TagList.astro";
import type { Proyecto } from "../lib/proyectos";
import { obtenerLang, rutaLocal, useTranslations } from "../i18n/utils";

interface Props {
  proyecto: Proyecto;
  indice: number;
}

interface Enlace {
  href: string;
  texto: string;
  descarga?: boolean;
}

const { proyecto, indice } = Astro.props;
const { titulo, resumen, tipo, portada, stack, rol, repo, demo, apk } =
  proyecto.data;

const lang = obtenerLang(Astro.currentLocale);
const t = useTranslations(lang);
const href = rutaLocal(lang, `proyectos/${proyecto.id}`);

/* Filas alternadas: la imagen cambia de lado en cada proyecto. */
const imagenDerecha = indice % 2 === 1;
const numero = String(indice + 1).padStart(2, "0");
const etiquetaTipo = t(
  tipo === "web" ? "proyectos.tipoWeb" : "proyectos.tipoMovil",
);

const externos = [
  repo && { href: repo, texto: t("accion.repositorio") },
  demo && { href: demo, texto: t("accion.visitar") },
  apk && { href: apk.url, texto: t("accion.descargarApk"), descarga: true },
].filter((enlace): enlace is Enlace => Boolean(enlace));
---

<article class="rise grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
  <a
    href={href}
    class="group block"
    class:list={[imagenDerecha && "lg:order-2"]}
    aria-label={t("proyectos.verCasoDe", { titulo })}
  >
    <DeviceFrame
      tipo={tipo}
      src={portada}
      alt={t("proyectos.capturaDe", { titulo })}
      eager={indice === 0}
    />
  </a>

  <div class:list={[imagenDerecha && "lg:order-1"]}>
    <p class="font-display text-sm tracking-[0.2em] text-accent uppercase">
      {numero} / {etiquetaTipo}
    </p>

    <h3 class="mt-3 text-4xl font-bold sm:text-5xl">
      <a href={href} class="hover:text-accent-soft">
        {titulo}
      </a>
    </h3>

    <p class="mt-4 max-w-prose text-lg text-ink-muted">{resumen}</p>

    <TagList rol={rol} stack={stack} class="mt-6" />

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <ActionLink
        href={href}
        texto={t("proyectos.verCaso")}
        variante="primario"
      />
      {externos.map((enlace) => (
        <ActionLink {...enlace} externo={!enlace.descarga} />
      ))}
    </div>
  </div>
</article>
